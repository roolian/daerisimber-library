<div x-data="{ open: false }" class="bg-white border-b-2 border-gray-100">
    <div class="container mx-auto ">
        <div class="flex justify-between items-center">
            <div class="py-5 text-3xl">
                <a class="block" href="{{ site.url }}" title="{{ site.title }}">
                    {% if logo_url %}
                        <img class="h-10" src="{{ logo_url }}" alt="{{ site.title }}">
                    {% else %}
                        {{ site.title }}
                    {% endif %}
                </a>
            </div>

            <nav class="flex gap-10 max-lg:hidden">
                {% for item in main_menu.items  %}
                    <a href="{{ item.url }}" class="f">
                        {{ item.title }}
                    </a>
                {% endfor %}
            </nav>

            <button @click="open = !open" class="lg:hidden">
                {{ display_icon('menu') }}
            </button>

            <div 
                x-cloak class="absolute inset-0 z-50 bg-white " 
                x-show="open"
                x-transition:enter="transition ease-out duration-300"
                x-transition:enter-start="opacity-0"
                x-transition:enter-end="opacity-100"
                x-transition:leave="transition ease-in duration-300"
                x-transition:leave-start="opacity-100"
                x-transition:leave-end="opacity-0"
            >
                <button @click="open = !open" class="lg:hidden absolute top-5 right-5">
                    {{ display_icon('close') }}
                </button>
                <nav x-cloak class="flex flex-col gap-10 items-center justify-center h-full">
                    {% for item in main_menu.items  %}
                        <a href="{{ item.url }}" class="f">
                            {{ item.title }}
                        </a>
                    {% endfor %}
                </nav>
            </div>

        </div>
    </div>
</div>
